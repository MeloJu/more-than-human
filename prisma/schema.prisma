// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

/**
 * Traço passivo: sempre ativo, sem ativação e sem duração.
 *
 * Transformação é ESTADO TEMPORÁRIO — liga, custa, e cai. Traço é o que o
 * personagem É. Os Seis Olhos do Gojo não se ativam: ele nasceu com eles.
 * Forçar isso a ser transformação daria a coisa errada, um botão para ligar
 * os próprios olhos.
 *
 * energyCostModifier é o motivo de o traço não ser só um bônus de atributo
 * disfarçado: -0.30 significa que toda habilidade custa 30% menos energia.
 * É a leitura correta dos Seis Olhos, que na obra são sobre EFICIÊNCIA de
 * energia amaldiçoada, não sobre bater mais forte.
 *
 * characterId nulo fica reservado para traço concedido por clã, que é o
 * próximo passo — a mesma tabela serve aos dois casos.
 */
model Trait {
  id               String  @id @default(cuid())
  name             String
  description      String?
  character        Character? @relation(fields: [characterId], references: [id])
  characterId      String?
  levelRequirement Int     @default(1)

  energyModifier  Float @default(0)
  attackModifier  Float @default(0)
  defenseModifier Float @default(0)
  speedModifier   Float @default(0)

  flatHpBonus      Int @default(0)
  flatAttackBonus  Int @default(0)
  flatDefenseBonus Int @default(0)
  flatSpeedBonus   Int @default(0)

  /// Fração subtraída do custo de energia de toda habilidade. -0.3 = 30% mais barato.
  energyCostModifier Float @default(0)

  /// Ícone do traço. Ver o comentário em Skill.icon.
  icon String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterId, name])
  @@index([characterId, levelRequirement])
}

model Transformation {
  id               String                @id @default(cuid())
  character        Character             @relation(fields: [characterId], references: [id])
  characterId      String
  name             String
  description      String?
  levelRequirement Int                   @default(1)
  energyModifier   Float                 @default(0) // percentage delta e.g. 0.15 for +15%
  attackModifier   Float                 @default(0)
  defenseModifier  Float                 @default(0)
  speedModifier    Float                 @default(0)
  flatHpBonus      Int                   @default(0)
  flatAttackBonus  Int                   @default(0)
  flatDefenseBonus Int                   @default(0)
  flatSpeedBonus   Int                   @default(0)
  drainPerTurn     Int                   @default(0) // energy drain each turn
  /// Vida drenada por rodada. Separado do dreno de energia porque o preço é
  /// de natureza diferente: ficar sem energia faz a forma CAIR, ficar sem
  /// vida faz o personagem MORRER. É o custo dos Oito Portões e do Mangekyō,
  /// que na obra cobram o corpo e não o chakra.
  drainHpPerTurn   Int                   @default(0)

  /// Se ativar esta forma gasta a rodada.
  ///
  /// Super Saiyan gasta: o Goku para, grita, e leva porrada enquanto isso.
  /// Bankai não — ele é liberado no meio da troca e o golpe segue. Por isso é
  /// campo e não regra fixa.
  consumesTurn     Boolean               @default(true)

  /// Energia cobrada NA ATIVAÇÃO, uma vez.
  ///
  /// Existe por causa das formas que não gastam a rodada: sem custo nenhum,
  /// elas seriam ativação obrigatória na rodada 1 e deixariam de ser decisão
  /// — viraria "no nível 20 você é mais forte", que é aumento de atributo com
  /// um clique extra. Com custo, a pergunta passa a ser QUANDO liberar: agora,
  /// e ficar sem energia para o resto da luta, ou depois.
  activationCost   Int                   @default(0)
  unlocksSkill     Skill?                @relation("TransformationUnlockSkill", fields: [unlocksSkillId], references: [id])
  unlocksSkillId   String?
  triggerType      TransformationTrigger @default(MANUAL)
  triggerPayload   Json?
  imageUrl         String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  userTransformations UserCharacterTransformation[]
  activeFor           UserCharacter[]               @relation("ActiveTransformation")

  @@index([characterId, levelRequirement])
}

model UserCharacterTransformation {
  id               String         @id @default(cuid())
  userCharacter    UserCharacter  @relation(fields: [userCharacterId], references: [id])
  userCharacterId  String
  transformation   Transformation @relation(fields: [transformationId], references: [id])
  transformationId String
  unlockedAt       DateTime       @default(now())
  unlockedAtLevel  Int

  @@unique([userCharacterId, transformationId])
}

enum TransformationTrigger {
  MANUAL
  LOW_HP
  ON_DAMAGE_TAKEN
  ENERGY_CHARGE
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core domain for the game
model Anime {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  characters    Character[]
  affiliations  Affiliation[]
  storyChapters StoryChapter[]
  equipment     Equipment[]
}

model Affiliation {
  id         String      @id @default(cuid())
  name       String
  anime      Anime       @relation(fields: [animeId], references: [id])
  animeId    String
  characters Character[]

  @@unique([animeId, name])
}

model Character {
  id            String         @id @default(cuid())
  class         CharacterClass @default(ATACANTE)
  name          String
  slug          String?        @unique
  imageUrl      String?
  /// Cor de destaque da batalha, em hex. Deriva da propria arte do
  /// personagem (ver scripts/cor-por-personagem.js) em vez de ser escolhida
  /// a mao: assim a cor acompanha o retrato quando ele muda.
  ///
  /// Mora aqui, e nao em Anime, porque Ichigo e Hitsugaya sao os dois de
  /// Bleach e tem identidade cromatica oposta. Nulo cai no --accent do tema.
  corDestaque   String?
  /// Segunda cor da arte, a 60 graus ou mais da primeira. Usada quando os
  /// dois lados de um confronto teriam a mesma cor — ver
  /// app/lib/battle/cores.ts.
  corSecundaria String?
  description   String?
  anime         Anime          @relation(fields: [animeId], references: [id])
  animeId       String
  affiliation   Affiliation?   @relation(fields: [affiliationId], references: [id])
  affiliationId String?

  // Base stats
  hp      Int @default(100)
  attack  Int @default(10)
  defense Int @default(10)
  speed   Int @default(10)
  energy  Int @default(100)
  /// Reserva DEFENSIVA. Habilidade que só protege (escudo, cura, counter,
  /// buff em si mesmo) é paga daqui em vez da energia — ver custaStamina em
  /// app/lib/battle/engine.ts. Existe para separar "quantas vezes eu ataco"
  /// de "quantas vezes eu me protejo", que antes disputavam a mesma barra.
  stamina Int @default(80)

  /// ACURACIA, AGILIDADE e INTELIGENCIA. Os tres foram acrescentados juntos
  /// porque os seis atributos anteriores cobriam bater e aguentar, e nenhum
  /// cobria ERRAR nem APRENDER.
  ///
  /// Nenhum dos tres escala por nivel, ao contrario dos outros seis. Se
  /// acuracia e agilidade escalassem, a DIFERENCA entre elas cresceria junto
  /// e a evasao inflaria sozinha ao longo do jogo: o mesmo confronto que da
  /// 6% no nivel 1 daria o teto de 15% no nivel 14, sem ninguem ter escolhido
  /// isso. Ver scaleForLevel em app/lib/battle/engine.ts.
  ///
  /// Os valores base saem da CLASSE (ver perfilDeClasse em
  /// prisma/catalog/atributos-novos.js), nao de numero individual: por
  /// enquanto sao tracos de arquetipo, e o catalogo permite excecao quando
  /// algum personagem pedir.

  /// Chance de o golpe acertar. Entra contra a agilidade do alvo.
  accuracy     Int @default(11)
  /// Chance de desviar. Contra a acuracia de quem ataca, com teto de 15% —
  /// ver EVASAO_MAXIMA. Separada de speed de proposito: velocidade ja paga
  /// iniciativa e critico, e por isso ja custa o dobro por ponto.
  agility      Int @default(11)
  /// Barateia o treino, e no futuro o nivel das habilidades. E atributo de
  /// PROGRESSAO, nao de combate: nao entra em nenhuma conta de dano.
  intelligence Int @default(11)

  // Relations
  characterSkills CharacterSkill[]
  treeNodes       SkillTreeNode[]
  userCharacters  UserCharacter[]
  enemyBattles    Battle[]         @relation("EnemyCharacter")
  transformations Transformation[]
  traits          Trait[]
  storyStages     StoryStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animeId, name])
}

/// Papel do personagem em combate. Define a distribuição dos stats base e QUAL
/// ESCADA de habilidades ele recebe — antes a escada vinha da afiliação, o que
/// obrigava Chad e Orihime a dividirem as mesmas técnicas só por serem os dois
/// de Karakura, apesar de um ser tanque e a outra suporte.
///
/// Classe não é gaiola: ela dá as ferramentas e a linha de base, mas os pontos
/// de nível são gastos onde o jogador quiser. É o que permite "suporte que
/// builda dano".
enum CharacterClass {
  TANQUE
  ATACANTE
  VELOZ
  SUPORTE
  CONJURADOR
  INVOCADOR
}

enum SkillCategory {
  NINJUTSU
  GENJUTSU
  TAIJUTSU
  HADO
  BAKUDO
  KIDO
  KI
  OTHER
}

// Atributo do qual uma habilidade tira força. Existe para que kidō recompense
// energia e taijutsu recompense ataque — sem isso todo build ótimo é o mesmo
// build, porque só ataque influenciava dano.
enum ScalingStat {
  ATTACK
  DEFENSE
  SPEED
  ENERGY
}

model Skill {
  id          String        @id @default(cuid())
  name        String
  description String?
  /// O que o personagem DIZ ao usar o golpe, mostrado no histórico da batalha.
  /// Separado de `description`, que é a explicação do tooltip: as frases do
  /// Deadpool e do Patolino são fala, não explicação.
  fala          String?
  category    SkillCategory
  power       Int           @default(10) // base multiplier or flat power
  energyCost  Int           @default(10)
  cooldown    Int           @default(0)
  /// PRECISAO da habilidade, em porcento. E a confiabilidade do golpe em si,
  /// independente de quem lanca — o par da acuracia, que e de quem lanca.
  ///
  /// 100 e o padrao e reproduz o comportamento antigo, em que nada errava.
  /// Abaixo disso a habilidade vira uma aposta: um golpe pesado e impreciso
  /// deixa de ser sempre a melhor escolha pelo maior numero, que era o unico
  /// criterio que existia.
  precision   Int           @default(100)
  tags        Json // JSON array of strings, e.g., ["bleed", "stun", "fire"] - flavor only
  /// Ícone da habilidade. Curto de propósito — um emoji ou o nome de um
  /// glifo de biblioteca aberta — porque arte de anime é material com
  /// direito autoral e este repositório é público.
  icon        String?
  effects     Json          @default("[]") // JSON array of SkillEffect (see app/lib/battle/types.ts) - mechanical source of truth
  // De qual atributo do lançador esta habilidade escala. Ver SCALING_COEFFICIENT
  // em app/lib/battle/constants.ts. ATTACK reproduz o comportamento antigo,
  // em que TODA habilidade escalava de ataque e energia era só mana.
  scalingStat ScalingStat   @default(ATTACK)

  // Ownership is many-to-many with characters
  characterLinks           CharacterSkill[]
  // Back-relations
  treeNodes                SkillTreeNode[]
  turns                    Turn[]
  grantedByTransformations Transformation[]             @relation("TransformationUnlockSkill")
  monsterLinks             MonsterSkill[]
  equippedBy               UserCharacterEquippedSkill[]
  grantedTo                UserCharacterSkill[]
  grantedByEquipment       Equipment[]                  @relation("EquipmentGrantedSkill")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, category])
}

/// Enemy for raid battles (app/lib/battle/actions.ts's startRaidBattle) and
/// story-mode stages (StoryStage.enemyMonster).
model Monster {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  imageUrl      String?
  tier          Int            @default(1) // future difficulty/progression gate
  hp            Int            @default(100)
  attack        Int            @default(10)
  defense       Int            @default(10)
  speed         Int            @default(10)
  energy        Int            @default(100)
  /// Mesma reserva defensiva do Character. Monstro sem ela seria o único
  /// combatente incapaz de usar habilidade de proteção.
  stamina Int @default(80)
  monsterSkills MonsterSkill[]
  battles       Battle[]
  storyStages   StoryStage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model MonsterSkill {
  id        String  @id @default(cuid())
  monster   Monster @relation(fields: [monsterId], references: [id])
  monsterId String
  skill     Skill   @relation(fields: [skillId], references: [id])
  skillId   String

  @@unique([monsterId, skillId])
}

model CharacterSkill {
  // Join table for Character <-> Skill with extra metadata
  id               String    @id @default(cuid())
  character        Character @relation(fields: [characterId], references: [id])
  characterId      String
  skill            Skill     @relation(fields: [skillId], references: [id])
  skillId          String
  requiredLevel    Int       @default(1)
  learnedByDefault Boolean   @default(false)

  @@unique([characterId, skillId])
}

model SkillTreeNode {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id])
  characterId String
  // A node may unlock a Skill or be a passive stat node
  skill       Skill?    @relation(fields: [skillId], references: [id])
  skillId     String?
  name        String
  description String?
  tier        Int       @default(1)
  pointCost   Int       @default(1)

  // Flat stat bonuses applied while unlocked (for nodes with no skillId, i.e. pure stat nodes)
  flatHpBonus      Int @default(0)
  flatAttackBonus  Int @default(0)
  flatDefenseBonus Int @default(0)
  flatSpeedBonus   Int @default(0)

  /// Ícone do nó. Ver o comentário em Skill.icon.
  icon             String?

  // Self-referential many-to-many for prerequisites
  prerequisites SkillTreeNode[] @relation("Prerequisites")
  unlocks       SkillTreeNode[] @relation("Prerequisites")

  userUnlocks UserSkillUnlock[]

  @@index([characterId, tier])
}

model User {
  id                   String              @id @default(cuid())
  username             String              @unique @default("devuser")
  email                String              @unique
  name                 String?
  passwordHash         String // Simple auth placeholder; swap to Auth.js later
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  characters           UserCharacter[]
  battles              Battle[]
  role                 UserRole            @default(USER)
  // Currently selected character for dashboard
  selectedCharacter    UserCharacter?      @relation("SelectedCharacter", fields: [selectedCharacterId], references: [id])
  selectedCharacterId  String?
  sessions             Session[]
  storyProgress        UserStoryProgress[]
  equipment            UserEquipment[]
  pvpQueue             PvpQueue?
  pvpBattlesAsOpponent Battle[]            @relation("OpponentUser")
  // Carteira da conta, compartilhada entre todos os personagens do usuário.
  // Ganha no modo história; gasta na loja (ainda não implementada).
  coins                Int                 @default(0)
}

model UserCharacter {
  id                     String          @id @default(cuid())
  user                   User            @relation(fields: [userId], references: [id])
  userId                 String
  character              Character       @relation(fields: [characterId], references: [id])
  characterId            String
  level                  Int             @default(1)
  experience             Int             @default(0)
  pointsAvailable        Int             @default(0)

  /// Pontos de nível gastos em atributo, por atributo.
  ///
  /// Existem porque o ponto não tinha para onde ir: ele só comprava nó de
  /// árvore de habilidade, e 39 dos 52 personagens não têm nó nenhum. Quem
  /// jogasse com qualquer um deles acumulava pontos que nunca viravam nada.
  ///
  /// Guardado como pontos GASTOS e não como bônus final de propósito: assim
  /// mudar quanto cada ponto vale (ver ATRIBUTO_POR_PONTO) reajusta todo
  /// mundo de uma vez, em vez de deixar personagens antigos com números
  /// calculados por uma regra que não existe mais.
  allocHp                Int             @default(0)
  allocAttack            Int             @default(0)
  allocDefense           Int             @default(0)
  allocSpeed             Int             @default(0)
  allocEnergy            Int             @default(0)
  allocStamina           Int             @default(0)
  allocAccuracy          Int             @default(0)
  allocAgility           Int             @default(0)
  allocIntelligence      Int             @default(0)

  /// Quantos treinos este personagem já comprou. Guardado só para PRECIFICAR
  /// o próximo: o ganho em si vai para as colunas alloc acima, para que a
  /// matemática de atributo continue num lugar só.
  ///
  /// O preço crescente é o que substitui um teto diário — em vez de proibir,
  /// encarece, e o jogador decide quando parou de valer a pena.
  treinos                Int             @default(0)
  nickname               String          @default("Hero")
  pvpWins                Int             @default(0)
  npcWins                Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  activeTransformation   Transformation? @relation("ActiveTransformation", fields: [activeTransformationId], references: [id])
  activeTransformationId String?

  skillUnlocks          UserSkillUnlock[]
  playerBattles         Battle[]                      @relation("PlayerCharacter")
  selectedBy            User[]                        @relation("SelectedCharacter")
  transformationUnlocks UserCharacterTransformation[]
  equippedSkills        UserCharacterEquippedSkill[]
  grantedSkills         UserCharacterSkill[]
  equipment             UserEquipment[]
  pvpQueue              PvpQueue[]
  pvpBattlesAsOpponent  Battle[]                      @relation("OpponentCharacter")
  storyProgress         UserStoryProgress[]

  @@unique([userId, characterId])
}

model UserSkillUnlock {
  id              String        @id @default(cuid())
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id])
  userCharacterId String
  node            SkillTreeNode @relation(fields: [nodeId], references: [id])
  nodeId          String
  unlockedAt      DateTime      @default(now())

  @@unique([userCharacterId, nodeId])
}

/// Which of a UserCharacter's eligible skills are equipped for battle
/// (max slots enforced in app code via MAX_LOADOUT_SLOTS).
model UserCharacterEquippedSkill {
  id              String        @id @default(cuid())
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id])
  userCharacterId String
  skill           Skill         @relation(fields: [skillId], references: [id])
  skillId         String
  slot            Int

  @@unique([userCharacterId, skillId])
  @@unique([userCharacterId, slot])
}

/// Resultado de uma batalha terminada.
///
/// Vivia só dentro do JSON de `state`, o que tornava impossível PERGUNTAR
/// "quantas vitórias este personagem teve hoje" sem carregar e desserializar
/// todas as batalhas do dia. O teto diário de recompensa precisa exatamente
/// dessa pergunta.
enum BattleOutcome {
  PLAYER_WIN
  ENEMY_WIN
  DRAW
}

enum BattleStatus {
  PENDING
  ACTIVE
  FINISHED
}

enum ActorSide {
  PLAYER
  ENEMY
}

model Battle {
  id                    String         @id @default(cuid())
  user                  User           @relation(fields: [userId], references: [id])
  userId                String
  playerCharacter       UserCharacter  @relation("PlayerCharacter", fields: [playerCharacterId], references: [id])
  playerCharacterId     String
  // Exactly one of enemyCharacter/enemyMonster is set - enforced in app code,
  // not the DB (SQLite has no simple declarative CHECK constraint here).
  enemyCharacter        Character?     @relation("EnemyCharacter", fields: [enemyCharacterId], references: [id])
  enemyCharacterId      String?
  enemyMonster          Monster?       @relation(fields: [enemyMonsterId], references: [id])
  enemyMonsterId        String?
  // Set when the battle was started from a story stage, so finishing it can
  // record progress. Null for AI/raid battles.
  storyStage            StoryStage?    @relation(fields: [storyStageId], references: [id])
  storyStageId          String?
  // PvP: o adversário é o UserCharacter de OUTRO jogador, não um Character do
  // catálogo nem um Monster. Quando estes estão preenchidos, a batalha é PvP.
  opponentUser          User?          @relation("OpponentUser", fields: [opponentUserId], references: [id])
  opponentUserId        String?
  opponentCharacter     UserCharacter? @relation("OpponentCharacter", fields: [opponentCharacterId], references: [id])
  opponentCharacterId   String?
  /// Ações submetidas na rodada corrente. A rodada só resolve quando as DUAS
  /// chegam: o motor (resolveRound) já resolve os dois lados de uma vez, em
  /// ordem de velocidade, então PvP é turno SIMULTÂNEO — ninguém joga vendo
  /// a escolha do outro.
  pendingHostAction     Json?
  pendingOpponentAction Json?
  status                BattleStatus   @default(PENDING)
  /// Preenchido quando a batalha termina. Nulo enquanto ela corre.
  outcome               BattleOutcome?
  turnNumber            Int            @default(1)
  // JSON state snapshot for current combat (HP, energy, effects)
  state                 Json
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  turns Turn[]
}

model Turn {
  id        String    @id @default(cuid())
  battle    Battle    @relation(fields: [battleId], references: [id])
  battleId  String
  /// Ordem GLOBAL da acao dentro da batalha. Nao e a rodada: uma rodada
  /// produz de duas a cinco linhas aqui.
  number    Int
  /// A rodada a que esta acao pertence, para o historico poder agrupar.
  ///
  /// Sem ela o log era uma lista corrida em que nao dava para ver onde uma
  /// rodada acabava e a outra comecava — o jogador via cinco frases seguidas
  /// sem saber quais delas foram consequencia do clique que ele acabou de dar.
  ///
  /// 0 significa "gravado antes desta coluna existir": batalhas antigas
  /// aparecem sem agrupamento, em vez de todas juntas numa rodada falsa.
  round     Int       @default(0)
  actor     ActorSide
  skill     Skill?    @relation(fields: [skillId], references: [id])
  skillId   String?
  result    Json // damage dealt, effects applied, crits, etc.
  createdAt DateTime  @default(now())

  @@index([battleId, number])
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Modo história: capítulos lineares de um anime, cada um com estágios
/// ordenados. Um estágio é uma batalha roteirizada com narrativa antes e
/// depois, liberado só quando o anterior foi concluído.
model StoryChapter {
  id          String       @id @default(cuid())
  anime       Anime        @relation(fields: [animeId], references: [id])
  animeId     String
  slug        String       @unique
  title       String
  description String?
  order       Int
  stages      StoryStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animeId, order])
}

model StoryStage {
  id        String       @id @default(cuid())
  chapter   StoryChapter @relation(fields: [chapterId], references: [id])
  chapterId String
  order     Int
  title     String

  // Narrativa exibida antes da batalha e depois da vitória.
  introText String
  outroText String

  /// Diálogo encenado antes da luta: um array de { speaker, text }, em que
  /// speaker nulo é narração. Fica separado de introText de propósito —
  /// introText é o parágrafo de contexto que continua na tela do estágio, e
  /// este é a cena que abre quando se clica para batalhar.
  ///
  /// Json em vez de tabela própria porque a fala não é consultada nem
  /// referenciada por nada: ela é lida inteira, sempre junto com o estágio.
  /// Uma tabela só somaria um join para nunca filtrar por linha.
  ///
  /// Nulo significa "sem cena", e a tela cai no comportamento antigo.
  introDialogue Json?

  /// Mesma forma do introDialogue, encenada quando o inimigo cai. É o desfecho
  /// no momento em que ele acontece, e não um parágrafo que o jogador lê
  /// depois na tela do estágio.
  outroDialogue Json?

  // Exatamente um dos dois é preenchido — mesma convenção do model Battle,
  // garantida no código da aplicação e não por constraint declarativa.
  enemyCharacter   Character? @relation(fields: [enemyCharacterId], references: [id])
  enemyCharacterId String?
  enemyMonster     Monster?   @relation(fields: [enemyMonsterId], references: [id])
  enemyMonsterId   String?
  // Escala o inimigo sem precisar de uma linha própria por dificuldade.
  enemyLevel       Int        @default(1)

  // ATRIBUTOS PRÓPRIOS DO CHEFE, aplicados por cima da escala por nível.
  //
  // Existem porque os mesmos números serviam a dois donos. Byakuya é
  // personagem jogável E chefe do estágio 6: deixá-lo derrotável como chefe o
  // deixava fraco como escolha, e vice-versa. Toda tentativa de equilibrar via
  // constante global mexia nos dois lados ao mesmo tempo — subir a referência
  // de velocidade consertava os chefes VELOZ e derrubava a Yoruichi jogável de
  // 44% para 2%.
  //
  // Cada campo é OPCIONAL e independente: dá para corrigir só a velocidade de
  // um chefe sem reescrever o resto do bloco. Nulo significa "usa o valor
  // escalado do personagem", que é o comportamento anterior.
  bossHp      Int?
  bossAttack  Int?
  bossDefense Int?
  bossSpeed   Int?
  bossEnergy  Int?

  xpReward   Int @default(50)
  // Skill não é recompensa direta de estágio: elas vêm por nível (via
  // CharacterSkill.requiredLevel) ou são compradas. O estágio paga em moeda,
  // que é o que vai alimentar a loja.
  coinReward Int @default(0)

  progress UserStoryProgress[]
  battles  Battle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, order])
}

/// Progresso de história é POR PERSONAGEM, não por conta.
///
/// Era por conta: concluir um estágio com um personagem o desbloqueava para
/// todos, então dava para atravessar a história com o personagem forte e usar
/// o progresso para pular a parte difícil com os outros — e nenhum deles
/// precisava subir de nível para isso.
///
/// userId continua aqui porque toda consulta parte do dono, e mantê-lo evita
/// um join a UserCharacter só para responder "de quem é esta linha".
model UserStoryProgress {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id], onDelete: Cascade)
  userCharacterId String
  stage           StoryStage    @relation(fields: [stageId], references: [id])
  stageId         String
  completedAt     DateTime      @default(now())

  @@unique([userCharacterId, stageId])
  @@index([userId])
  @@index([userCharacterId])
}

/// Skill que um UserCharacter específico ganhou fora do kit base e fora da
/// árvore — hoje, só como recompensa de estágio do modo história.
///
/// Precisa existir porque nenhum dos dois mecanismos anteriores serve: o
/// CharacterSkill pertence ao personagem do catálogo (concedê-la ali daria a
/// skill a todos os jogadores daquele personagem), e o UserSkillUnlock exige
/// um SkillTreeNode, que é modelado por personagem e não por recompensa.
model UserCharacterSkill {
  id              String        @id @default(cuid())
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id])
  userCharacterId String
  skill           Skill         @relation(fields: [skillId], references: [id])
  skillId         String
  source          String        @default("STORY")
  grantedAt       DateTime      @default(now())

  @@unique([userCharacterId, skillId])
  @@index([userCharacterId])
}

enum EquipmentSlot {
  ZANPAKUTO
  TRAJE
  ACESSORIO
}

/// Raridade é regra de jogo (limita o que a loja vende cedo) e também o
/// vocabulário visual da UI — cada nível tem sua cor e brilho.
enum EquipmentRarity {
  COMUM
  RARO
  EPICO
  LENDARIO
}

/// Item comprável na loja. É o primeiro sumidouro das moedas ganhas no modo
/// história — até aqui elas só acumulavam.
///
/// Os bônus de stat usam os mesmos nomes de campo do SkillTreeNode de
/// propósito: os dois são somados no mesmo ponto antes de virar os stats de
/// batalha (ver getEquipmentBonus/computeBaseStats), então manter o formato
/// idêntico evita conversão no meio.
model Equipment {
  id            String          @id @default(cuid())
  name          String          @unique
  description   String
  slot          EquipmentSlot
  rarity        EquipmentRarity @default(COMUM)
  price         Int
  /// Nível mínimo do personagem pra equipar (comprar é liberado antes).
  requiredLevel Int             @default(1)

  flatHpBonus      Int @default(0)
  flatAttackBonus  Int @default(0)
  flatDefenseBonus Int @default(0)
  flatSpeedBonus   Int @default(0)

  /// Skill que o item concede enquanto equipado. Ela NÃO ocupa um dos 4
  /// slots do loadout: entra na batalha por cima deles (ver
  /// getEquippedSkills), que é o que dá peso a equipar um Zanpakutō.
  grantedSkill   Skill?  @relation("EquipmentGrantedSkill", fields: [grantedSkillId], references: [id])
  grantedSkillId String?

  /// Item é temático de um anime; null = genérico, serve pra qualquer um.
  anime   Anime?  @relation(fields: [animeId], references: [id])
  animeId String?

  imageUrl String?

  ownedBy UserEquipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot])
}

/// Um item comprado. A compra é da CONTA (assim como as moedas), e o item é
/// equipado em um personagem por vez — comprar a Zangetsu uma vez e poder
/// trocá-la entre personagens é o comportamento esperado de inventário.
///
/// `slot` é copiado do Equipment pra que a unicidade "um item por slot por
/// personagem" possa ser garantida pelo banco. No Postgres, NULL não colide
/// em índice único, então vários itens desequipados (equippedOnId = null)
/// convivem sem problema.
model UserEquipment {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  equipment   Equipment     @relation(fields: [equipmentId], references: [id])
  equipmentId String
  slot        EquipmentSlot

  equippedOn   UserCharacter? @relation(fields: [equippedOnId], references: [id])
  equippedOnId String?

  purchasedAt DateTime @default(now())

  @@unique([userId, equipmentId])
  @@unique([equippedOnId, slot])
  @@index([userId])
}

/// Fila de matchmaking do PvP. Uma linha por jogador esperando.
///
/// userId é único: entrar na fila duas vezes (duas abas) não pode gerar dois
/// pareamentos com o mesmo jogador. O pareamento em si é uma transação que
/// remove os dois da fila e cria a batalha — ver lib/pvp/actions.ts.
model PvpQueue {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String        @unique
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id])
  userCharacterId String
  joinedAt        DateTime      @default(now())

  @@index([joinedAt])
}
