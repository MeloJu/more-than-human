# Copie para .env na VM (mesma pasta do docker-compose.prod.yml). Nunca
# commitar o .env real — ele só existe na VM.

# Domínio real (ativa HTTPS automático via Let's Encrypt) ou o IP público da
# VM. Pra IP, o prefixo `http://` é OBRIGATÓRIO: sem ele o Caddy tenta TLS,
# cai num certificado self-signed e redireciona tudo pra HTTPS (308) com
# aviso de certificado no navegador. Ver comentários no Caddyfile.
SITE_ADDRESS=http://123.45.67.89

# Seu usuário/organização do GitHub — dono da imagem no GHCR.
# TEM que ser em minúsculas, mesmo que seu login tenha maiúsculas: o GHCR
# rejeita nome de repositório com maiúscula e o `docker pull` falha.
GITHUB_REPOSITORY_OWNER=seu-usuario-github

# Gere uma senha forte só pra isso, ex: `openssl rand -base64 24`.
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_USER=animebattler
POSTGRES_DB=animebattler

# Cookie de sessão marcado como Secure só trafega em HTTPS. Deixe `true`
# (o correto) quando SITE_ADDRESS for um domínio de verdade — aí o Caddy emite
# TLS sozinho. Se estiver acessando pelo IP puro, o Caddy serve HTTP e o
# navegador DESCARTA o cookie em silêncio: o login simplesmente não funciona,
# sem erro nenhum na tela. Nesse caso, e só nesse, use `false`.
COOKIE_SECURE=true

# Preenchido automaticamente pelo workflow de deploy com o SHA do commit.
# Só defina à mão se quiser fixar/reverter para uma versão específica.
# IMAGE_TAG=latest
