# Copie para terraform.tfvars (gitignored) e preencha.
# Credenciais NÃO vão aqui — vêm do ~/.oci/config (perfil DEFAULT).

# Pode ser o OCID da própria tenancy (compartment raiz).
compartment_ocid = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Só se quiser fugir dos defaults:
# region      = "sa-saopaulo-1"
# bucket_name = "animebattler-tfstate"

# Preencha só para criar o usuário da caça à Ampere (ver acesso.tf):
# tenancy_ocid               = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# cacador_chave_publica_path = "C:/Users/voce/.oci/oci_api_key_cacador_public.pem"
# cacador_email              = "voce@exemplo.com"
